# schedule-calendar-sync 環境変数サンプル
# このファイルをコピーして .env を作成してください（.env はGitにコミットされません）
#   cp .env.example .env
#
# 通常のMVP利用では設定不要です。将来のWeb自動取得機能などで使用する想定の項目です。

# Google Calendar API の認証情報ファイルのパス（既定値のままで問題ありません）
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json

# SQLite データベースの保存先（既定値のままで問題ありません）
DATABASE_PATH=data/schedule_sync.db

# タイムゾーン（既定値のままで問題ありません）
APP_TIMEZONE=Asia/Tokyo
